#!/usr/bin/env python3
"""Claude Code plugin entry point for Ongo."""

import os
import sys


PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN_ROOT, "lib"))


def plugin_data_dir():
    configured = os.environ.get("ONGO_DATA_DIR") or os.environ.get(
        "CLAUDE_PLUGIN_DATA"
    )
    if configured:
        return os.path.expanduser(configured)
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        return os.path.join(os.path.expanduser(xdg), "ongo")
    return os.path.join(os.path.expanduser("~"), ".local", "share", "ongo")


# `ongo setup` installs platform wheels here so the plugin can keep its only
# non-stdlib Python dependency outside Claude's immutable plugin cache.
sys.path.insert(0, os.path.join(plugin_data_dir(), "python"))

from ongo.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
