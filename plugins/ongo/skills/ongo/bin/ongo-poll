#!/usr/bin/env python3
"""ongo-poll — robust Slack poll for the ongo tick loop.

Usage:
    ongo-poll <CHANNEL> <LAST_USER_TS>

Prints JSON. On success:
    {"status":"ok","total_seen":N,"user_count":N,
     "newest_user_ts":"<ts>","user_messages":[{"ts","text"},...]}
On read failure (rate limit / API error / unparseable):
    {"status":"error","error":"<msg>","user_count":0,
     "newest_user_ts":"<LAST_USER_TS unchanged>","user_messages":[]}

THE CALLER MUST CHECK status. status=="error" means "could NOT read" —
NOT "no new messages." On error the tick must report the failure and
back off, never treat it as an idle/all-clear tick. That conflation is
how the loop goes silently deaf.

Bug history (each fix exposed the next):
  1. Frozen cursor (advanced only on user msgs) -> deaf on idle channel.
  2. Bot-contaminated cursor (advanced on bot sends) -> user msgs before
     a later bot send filtered out.
  3. Three reads/poll (recent+--since+--after) tripled
     conversations.history volume; with 1-min fast-mode polling the
     token hit HTTP-429 'ratelimited'. And every read was try/except ->
     [] so a hard 429 read as "0 msgs, all clear" -> deaf again.

In force now:
  * Gate strictly on LAST_USER_TS (advances only on processed user
    messages, never on bot traffic).
  * ONE read per poll. Use `--since LAST_USER_TS` (semantically "at or
    after this time"): a Slack ts is a valid --since value and this
    returns the recent window correctly, unlike `--after` which returns
    a bounded oldest-first slice anchored at the cursor. One API call.
  * Distinguish FAILURE from EMPTY: detect non-JSON / traceback /
    'ratelimited', retry with exponential backoff, else status=error.
"""
import json
import subprocess
import sys
import time

LIM = "200"
BACKOFFS = (5, 15, 45)  # ~65s worst case before giving up


def _read_once(channel, last_user_ts):
    try:
        p = subprocess.run(
            ["clacks", "read", "-c", channel, "--since", last_user_ts,
             "-l", LIM],
            capture_output=True, text=True, timeout=60,
        )
    except Exception as e:
        return None, f"subprocess: {e}"
    out, err = p.stdout.strip(), p.stderr.strip()
    blob = out + "\n" + err
    if "ratelimited" in blob or "SlackApiError" in blob \
            or "Traceback" in blob:
        return None, "ratelimited" if "ratelimited" in blob else "api-error"
    try:
        return json.loads(out).get("messages", []), None
    except Exception:
        return None, f"unparseable: {(out or err)[:120]}"


def poll(channel, last_user_ts):
    msgs, error = _read_once(channel, last_user_ts)
    for delay in BACKOFFS:
        if error is None:
            break
        time.sleep(delay)
        msgs, error = _read_once(channel, last_user_ts)

    if error is not None:
        return {
            "status": "error",
            "error": error,
            "total_seen": 0,
            "user_count": 0,
            "newest_user_ts": last_user_ts,
            "user_messages": [],
        }

    def is_bot(m):
        return m.get("text", "").lstrip().startswith(("[ongo]", "_[ongo]"))

    allm = sorted((m for m in msgs if m.get("ts")), key=lambda m: m["ts"])
    # --since is inclusive; strictly exclude the gate message itself.
    users = [m for m in allm
             if not is_bot(m) and m.get("ts", "0") > last_user_ts]
    newest_user = max((m["ts"] for m in users), default=last_user_ts)
    return {
        "status": "ok",
        "total_seen": len(allm),
        "user_count": len(users),
        "newest_user_ts": newest_user,
        "user_messages": [
            {"ts": m["ts"], "text": m.get("text", "")} for m in users
        ],
    }


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.stderr.write("usage: ongo-poll <CHANNEL> <LAST_USER_TS>\n")
        sys.exit(2)
    print(json.dumps(poll(sys.argv[1], sys.argv[2])))
