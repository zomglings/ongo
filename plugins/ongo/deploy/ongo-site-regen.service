# Oneshot: regenerate the ongo-site directory from kendb.
# TEMPLATE — edit User/paths, then install with ongo-site-regen.timer:
#   sudo cp ongo-site-regen.service ongo-site-regen.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ongo-site-regen.timer
# Staged replacement: the running ongo-site.service needs no restart.

[Unit]
Description=Regenerate ongo-site from kendb (oneshot)
After=network.target

[Service]
Type=oneshot
# Replace with the user that owns the site directory.
User=ongo
Group=ongo
# /opt/ongo is a stable copy of one plugin release, not Claude's cache path.
WorkingDirectory=/opt/ongo
Environment=ONGO_DATA_DIR=/var/lib/ongo
ExecStart=/opt/ongo/bin/ongo site build --out /opt/ongo/site
TimeoutStartSec=600
Nice=10
